# ============================================================
# KKC Family Website – Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your Supabase credentials.
# Never commit .env.local to version control.

# Your Supabase project URL (from: Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anonymous/public key (from: Project Settings > API > anon/public)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

